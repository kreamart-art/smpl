{
  "name": "smpl",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "SMPL — Same sample. Different soul. A producer battle platform.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"node server/index.js\"",
    "web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "cap:assets": "npx @capacitor/assets@latest generate --iconBackgroundColor '#000000' --splashBackgroundColor '#000000'",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "html-to-image": "^1.11.13",
    "nodemailer": "^8.0.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
