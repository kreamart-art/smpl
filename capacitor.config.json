{
  "appId": "nl.artnomad.smpl",
  "appName": "SMPL",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["smpl.artnomad.nl"]
  },
  "ios": {
    "backgroundColor": "#000000"
  },
  "android": {
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
